pipeline {
    agent any

    environment {
        NEXUS_URL        = 'http://localhost:8081'
        NEXUS_REPO       = 'psi-mts-repo'
        NEXUS_CREDENTIAL = 'nexus-credentials'
        ARTIFACT_ID      = 'mts-backend'
        GROUP_ID         = 'com.mts'
        SONAR_URL        = 'http://localhost:9000'
        SONAR_CREDENTIAL = 'sonar-token'          // Add in Jenkins > Credentials (Secret text)
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Branch: ${env.BRANCH_NAME ?: 'N/A'}"
                echo "Build:  #${env.BUILD_NUMBER}"
                checkout scm
            }
        }

        stage('Compile') {
            steps {
                dir('mts-backend') {
                    bat 'mvn clean compile -B'
                }
            }
        }

        // ╔═══════════════════════════════════════════════════════════════╗
        // ║              CI PIPELINE — FUNCTIONAL TEST PYRAMID          ║
        // ║                                                              ║
        // ║                    /‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾\                       ║
        // ║                   /   E2E Tests       \   ← REST Assured    ║
        // ║                  / (real HTTP server)   \    fewest tests   ║
        // ║                 /‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾\                  ║
        // ║                / Integration Tests        \  ← Spring +    ║
        // ║               / (DB, MockMvc, wiring)      \   real DB    ║
        // ║              /‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾\             ║
        // ║             / Unit Tests                       \ ← Mockito ║
        // ║            / (no Spring, fastest, most tests)   \  mocks  ║
        // ║           /‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾\        ║
        // ║                                                              ║
        // ║   Tags:    @Tag("unit") | @Tag("integration") | @Tag("e2e") ║
        // ║   Run:     mvn test -Dgroups=<tag>                           ║
        // ╚═══════════════════════════════════════════════════════════════╝

        stage('Unit Test') {
            steps {
                dir('mts-backend') {
                    echo '=== PYRAMID BOTTOM: Unit Tests ==='
                    echo '--- No Spring context | Mockito mocks | Milliseconds ---'
                    bat 'mvn test -Dgroups=unit jacoco:report -B'
                }
            }
            post {
                always {
                    junit testResults: 'mts-backend\\target\\surefire-reports\\*.xml', allowEmptyResults: true
                }
            }
        }

        // ╔═══════════════════════════════════════════════════════════════╗
        // ║              SAST — Static Application Security Testing     ║
        // ║                                                              ║
        // ║   SonarQube scans source code for:                           ║
        // ║   • Security vulnerabilities (SQL injection, XSS, etc.)      ║
        // ║   • Code smells & technical debt                             ║
        // ║   • Bug patterns & reliability issues                        ║
        // ║   • Code coverage (via JaCoCo report)                        ║
        // ║   • Code duplications                                        ║
        // ║                                                              ║
        // ║   Dashboard: http://localhost:9000/dashboard?id=mts-backend  ║
        // ╚═══════════════════════════════════════════════════════════════╝

        stage('Code Quality Check (SAST)') {
            steps {
                dir('mts-backend') {
                    echo '=== SAST: SonarQube Static Analysis ==='
                    echo '--- Security vulnerabilities | Code smells | Coverage | Duplications ---'
                    withCredentials([string(
                        credentialsId: "${SONAR_CREDENTIAL}",
                        variable: 'SONAR_TOKEN'
                    )]) {
                        bat """
                            mvn sonar:sonar ^
                                -Dsonar.host.url=${SONAR_URL} ^
                                -Dsonar.login=%SONAR_TOKEN% ^
                                -B
                        """
                    }
                }
            }
        }

        // ╔═══════════════════════════════════════════════════════════════╗
        // ║   QUALITY GATE — Pass/Fail decision from SonarQube          ║
        // ║                                                              ║
        // ║   If Quality Gate FAILS → build FAILS (no deploy)            ║
        // ║   If Quality Gate PASSES → proceed to next stage             ║
        // ║                                                              ║
        // ║   Prereq: Install "SonarQube Scanner" plugin in Jenkins      ║
        // ║           Configure SonarQube server in Jenkins > System      ║
        // ║           Add webhook in SonarQube:                          ║
        // ║             Admin > Configuration > Webhooks > Create        ║
        // ║             URL: http://<jenkins-host>:8080/sonarqube-webhook/║
        // ╚═══════════════════════════════════════════════════════════════╝

        stage('Quality Gate') {
            steps {
                echo '=== Waiting for SonarQube Quality Gate result... ==='
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
                echo '=== Quality Gate PASSED — code meets quality standards ==='
            }
        }

        stage('Integration Test') {
            steps {
                dir('mts-backend') {
                    echo '=== PYRAMID MIDDLE: Integration Tests ==='
                    echo '--- @DataJpaTest + H2 | @WebMvcTest + MockMvc ---'
                    bat 'mvn test -Dgroups=integration -B'
                }
            }
            post {
                always {
                    junit testResults: 'mts-backend\\target\\surefire-reports\\*.xml', allowEmptyResults: true
                }
            }
        }

        stage('E2E Test') {
            steps {
                dir('mts-backend') {
                    echo '=== PYRAMID TOP: E2E Tests (REST Assured) ==='
                    echo '--- Full Spring Boot + real HTTP server + REST Assured ---'
                    bat 'mvn test -Dgroups=e2e -B'
                }
            }
            post {
                always {
                    junit testResults: 'mts-backend\\target\\surefire-reports\\*.xml', allowEmptyResults: true
                }
            }
        }

        stage('Package') {
            steps {
                dir('mts-backend') {
                    bat 'mvn package -DskipTests -B'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'mts-backend/target/*.jar', fingerprint: true
                }
            }
        }

        // ╔═══════════════════════════════════════════════════════════════╗
        // ║       UAT STAGE — NON-FUNCTIONAL TESTS (before release)     ║
        // ║                                                              ║
        // ║   These tests run ONLY when triggered manually or before     ║
        // ║   a production release. They are slower and validate         ║
        // ║   system-level behavior, not code changes.                   ║
        // ║                                                              ║
        // ║   Tags:  @Tag("security") | @Tag("performance")             ║
        // ║          @Tag("resilience")                                  ║
        // ╚═══════════════════════════════════════════════════════════════╝

        stage('UAT: Non-Functional Tests') {
            when {
                anyOf {
                    branch 'release/*'
                    branch 'main'
                    triggeredBy 'UserIdCause'   // Manual trigger
                }
            }
            stages {
                stage('Security Test') {
                    steps {
                        dir('mts-backend') {
                            echo '=== UAT: Security Tests ==='
                            echo '--- SQL injection | XSS | Malformed input | HTTP 405 ---'
                            bat 'mvn test -Dgroups=security -B'
                        }
                    }
                    post {
                        always {
                            junit testResults: 'mts-backend\\target\\surefire-reports\\*.xml', allowEmptyResults: true
                        }
                    }
                }
                stage('Performance Test') {
                    steps {
                        dir('mts-backend') {
                            echo '=== UAT: Performance Tests ==='
                            echo '--- Response time thresholds | Throughput ---'
                            bat 'mvn test -Dgroups=performance -B'
                        }
                    }
                    post {
                        always {
                            junit testResults: 'mts-backend\\target\\surefire-reports\\*.xml', allowEmptyResults: true
                        }
                    }
                }
                stage('Resilience Test') {
                    steps {
                        dir('mts-backend') {
                            echo '=== UAT: Resilience & Data Integrity Tests ==='
                            echo '--- Money conservation | Failure recovery | Notification down ---'
                            bat 'mvn test -Dgroups=resilience -B'
                        }
                    }
                    post {
                        always {
                            junit testResults: 'mts-backend\\target\\surefire-reports\\*.xml', allowEmptyResults: true
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Build SUCCEEDED'
        }
        failure {
            echo 'Build FAILED'
        }
        always {
            echo 'Cleaning workspace...'
            cleanWs()
        }
    }
}
