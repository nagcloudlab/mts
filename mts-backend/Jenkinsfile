pipeline {
    agent any

    environment {
        NEXUS_URL        = 'http://localhost:8081'
        NEXUS_REPO       = 'psi-mts-repo'
        NEXUS_CREDENTIAL = 'nexus-credentials'  // Add in Jenkins > Credentials
        ARTIFACT_ID      = 'mts-backend'
        GROUP_ID         = 'com.example'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))   // Keep last 5 builds
        timestamps()                                     // Add timestamps to console
        timeout(time: 15, unit: 'MINUTES')               // Fail if build hangs
        disableConcurrentBuilds()                        // One build at a time
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Branch: ${env.BRANCH_NAME ?: 'N/A'}"
                echo "Build:  #${env.BUILD_NUMBER}"
                checkout scm
            }
        }

        stage('Compile') {
            steps {
                dir('mts-backend') {
                    sh 'mvn clean compile -B'
                }
            }
        }

        stage('Unit Test') {
            steps {
                dir('mts-backend') {
                    sh 'mvn test -B'
                }
            }
            post {
                always {
                    junit testResults: 'mts-backend/target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('Package') {
            steps {
                dir('mts-backend') {
                    sh 'mvn package -DskipTests -B'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'mts-backend/target/*.jar', fingerprint: true
                }
            }
        }

        stage('Publish to Nexus') {
            steps {
                dir('mts-backend') {
                    script {
                        def pomVersion = sh(script: "mvn help:evaluate -Dexpression=project.version -q -DforceStdout", returnStdout: true).trim()
                        def jarFile    = "target/${ARTIFACT_ID}-${pomVersion}.jar"

                        echo "Publishing ${jarFile} to Nexus..."

                        withCredentials([usernamePassword(
                            credentialsId: "${NEXUS_CREDENTIAL}",
                            usernameVariable: 'NEXUS_USER',
                            passwordVariable: 'NEXUS_PASS'
                        )]) {
                            sh """
                                curl -v -u \$NEXUS_USER:\$NEXUS_PASS \\
                                     --upload-file ${jarFile} \\
                                     ${NEXUS_URL}/repository/${NEXUS_REPO}/${GROUP_ID.replace('.','/')}/${ARTIFACT_ID}/${pomVersion}/${ARTIFACT_ID}-${pomVersion}.jar
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Build SUCCEEDED'
            emailext(
                to:      'dev-team@example.com',
                subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body:    """
                    <h2>Build Successful</h2>
                    <p><b>Project:</b> ${env.JOB_NAME}</p>
                    <p><b>Build:</b>   #${env.BUILD_NUMBER}</p>
                    <p><b>URL:</b>     <a href='${env.BUILD_URL}'>${env.BUILD_URL}</a></p>
                """,
                mimeType: 'text/html'
            )
        }
        failure {
            echo 'Build FAILED'
            emailext(
                to:      'dev-team@example.com',
                subject: "FAILURE: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body:    """
                    <h2>Build Failed</h2>
                    <p><b>Project:</b> ${env.JOB_NAME}</p>
                    <p><b>Build:</b>   #${env.BUILD_NUMBER}</p>
                    <p><b>URL:</b>     <a href='${env.BUILD_URL}'>${env.BUILD_URL}</a></p>
                    <p>Check the <a href='${env.BUILD_URL}console'>console output</a> for details.</p>
                """,
                mimeType: 'text/html'
            )
        }
        always {
            echo 'Cleaning workspace...'
            cleanWs()
        }
    }
}
