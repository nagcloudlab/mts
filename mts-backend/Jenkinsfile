pipeline {
    agent any

    environment {
        NEXUS_URL        = 'http://localhost:8081'
        NEXUS_REPO       = 'psi-mts-repo'
        NEXUS_CREDENTIAL = 'nexus-credentials'
        ARTIFACT_ID      = 'mts-backend'
        GROUP_ID         = 'com.mts'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Branch: ${env.BRANCH_NAME ?: 'N/A'}"
                echo "Build:  #${env.BUILD_NUMBER}"
                checkout scm
            }
        }

        stage('Compile') {
            steps {
                dir('mts-backend') {
                    sh 'mvn clean compile -B'
                }
            }
        }

        // ╔═══════════════════════════════════════════════════════════════╗
        // ║              CI PIPELINE — FUNCTIONAL TEST PYRAMID          ║
        // ║                                                              ║
        // ║                    /‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾\                       ║
        // ║                   /   E2E Tests       \   ← REST Assured    ║
        // ║                  / (real HTTP server)   \    fewest tests   ║
        // ║                 /‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾\                  ║
        // ║                / Integration Tests        \  ← Spring +    ║
        // ║               / (DB, MockMvc, wiring)      \   real DB    ║
        // ║              /‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾\             ║
        // ║             / Unit Tests                       \ ← Mockito ║
        // ║            / (no Spring, fastest, most tests)   \  mocks  ║
        // ║           /‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾\        ║
        // ║                                                              ║
        // ║   Tags:    @Tag("unit") | @Tag("integration") | @Tag("e2e") ║
        // ║   Run:     mvn test -Dgroups=<tag>                           ║
        // ╚═══════════════════════════════════════════════════════════════╝

        stage('Unit Test') {
            steps {
                dir('mts-backend') {
                    echo '=== PYRAMID BOTTOM: Unit Tests ==='
                    echo '--- No Spring context | Mockito mocks | Milliseconds ---'
                    sh 'mvn test -Dgroups=unit -B'
                }
            }
            post {
                always {
                    junit testResults: 'mts-backend/target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('Integration Test') {
            steps {
                dir('mts-backend') {
                    echo '=== PYRAMID MIDDLE: Integration Tests ==='
                    echo '--- @DataJpaTest + H2 | @WebMvcTest + MockMvc ---'
                    sh 'mvn test -Dgroups=integration -B'
                }
            }
            post {
                always {
                    junit testResults: 'mts-backend/target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('E2E Test') {
            steps {
                dir('mts-backend') {
                    echo '=== PYRAMID TOP: E2E Tests (REST Assured) ==='
                    echo '--- Full Spring Boot + real HTTP server + REST Assured ---'
                    sh 'mvn test -Dgroups=e2e -B'
                }
            }
            post {
                always {
                    junit testResults: 'mts-backend/target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('Package') {
            steps {
                dir('mts-backend') {
                    sh 'mvn package -DskipTests -B'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'mts-backend/target/*.jar', fingerprint: true
                }
            }
        }

        // ╔═══════════════════════════════════════════════════════════════╗
        // ║       UAT STAGE — NON-FUNCTIONAL TESTS (before release)     ║
        // ║                                                              ║
        // ║   These tests run ONLY when triggered manually or before     ║
        // ║   a production release. They are slower and validate         ║
        // ║   system-level behavior, not code changes.                   ║
        // ║                                                              ║
        // ║   Tags:  @Tag("security") | @Tag("performance")             ║
        // ║          @Tag("resilience")                                  ║
        // ╚═══════════════════════════════════════════════════════════════╝

        stage('UAT: Non-Functional Tests') {
            when {
                anyOf {
                    branch 'release/*'
                    branch 'main'
                    triggeredBy 'UserIdCause'   // Manual trigger
                }
            }
            stages {
                stage('Security Test') {
                    steps {
                        dir('mts-backend') {
                            echo '=== UAT: Security Tests ==='
                            echo '--- SQL injection | XSS | Malformed input | HTTP 405 ---'
                            sh 'mvn test -Dgroups=security -B'
                        }
                    }
                    post {
                        always {
                            junit testResults: 'mts-backend/target/surefire-reports/*.xml', allowEmptyResults: true
                        }
                    }
                }
                stage('Performance Test') {
                    steps {
                        dir('mts-backend') {
                            echo '=== UAT: Performance Tests ==='
                            echo '--- Response time thresholds | Throughput ---'
                            sh 'mvn test -Dgroups=performance -B'
                        }
                    }
                    post {
                        always {
                            junit testResults: 'mts-backend/target/surefire-reports/*.xml', allowEmptyResults: true
                        }
                    }
                }
                stage('Resilience Test') {
                    steps {
                        dir('mts-backend') {
                            echo '=== UAT: Resilience & Data Integrity Tests ==='
                            echo '--- Money conservation | Failure recovery | Notification down ---'
                            sh 'mvn test -Dgroups=resilience -B'
                        }
                    }
                    post {
                        always {
                            junit testResults: 'mts-backend/target/surefire-reports/*.xml', allowEmptyResults: true
                        }
                    }
                }
            }
        }

        stage('Publish to Nexus') {
            steps {
                dir('mts-backend') {
                    script {
                        def pomVersion = sh(script: "mvn help:evaluate -Dexpression=project.version -q -DforceStdout", returnStdout: true).trim()
                        def jarFile    = "target/${ARTIFACT_ID}-${pomVersion}.jar"

                        echo "Publishing ${jarFile} to Nexus..."

                        withCredentials([usernamePassword(
                            credentialsId: "${NEXUS_CREDENTIAL}",
                            usernameVariable: 'NEXUS_USER',
                            passwordVariable: 'NEXUS_PASS'
                        )]) {
                            sh """
                                curl -v -u \$NEXUS_USER:\$NEXUS_PASS \\
                                     --upload-file ${jarFile} \\
                                     ${NEXUS_URL}/repository/${NEXUS_REPO}/${GROUP_ID.replace('.','/')}/${ARTIFACT_ID}/${pomVersion}/${ARTIFACT_ID}-${pomVersion}.jar
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Build SUCCEEDED'
        }
        failure {
            echo 'Build FAILED'
        }
        always {
            echo 'Cleaning workspace...'
            cleanWs()
        }
    }
}
